{
    "name": "subdomainto/sdk",
    "description": "Typed PHP SDK for adding customer custom domains to SaaS products with DNS, TLS, routing, widget, usage, and signed webhook APIs.",
    "keywords": [
        "custom-domains",
        "saas",
        "domain-management",
        "dns",
        "tls",
        "ssl",
        "api-client",
        "webhooks",
        "psr-18"
    ],
    "homepage": "https://docs.subdomain.to/sdks/php",
    "support": {
        "docs": "https://docs.subdomain.to/sdks/php",
        "issues": "https://github.com/subdomain-to/sdk/issues",
        "source": "https://github.com/subdomain-to/sdk"
    },
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "autoload": {"psr-4": {"SubdomainTo\\": "src/"}},
    "autoload-dev": {"psr-4": {"SubdomainTo\\Tests\\": "tests/"}},
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0 || ^12.0"
    },
    "config": {"sort-packages": true}
}
